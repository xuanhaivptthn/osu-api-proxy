{
  "name": "osu-api-proxy",
  "version": "1.0.0",
  "private": false,
  "description": "Local Node proxy for the osu! API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "npm run build && node dist/index.js",
    "check": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_GITHUB_USERNAME/osu-api-proxy.git"
  },
  "keywords": [
    "osu",
    "proxy",
    "api",
    "cloudflared"
  ],
  "author": "Your Name <you@example.com>",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^6.0.2",
    "ts-node-dev": "^2.0.0"
  }
}
